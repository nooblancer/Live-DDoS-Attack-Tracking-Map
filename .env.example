# =============================================================================
# DDoS Attack Tracking Map — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All variables have sensible defaults; you only need to override what differs.

# --- ML Model Paths ---
# Path to the trained XGBoost/RF model artifact
MODEL_PATH=models/ddos_model.joblib

# Path to the fitted StandardScaler artifact
SCALER_PATH=models/scaler.joblib

# Path to the JSON metadata file (features list, metrics, training date)
METADATA_PATH=models/metadata.json

# --- Database ---
# SQLite database file for storing attack records
DB_PATH=data/attacks.db

# --- Threat Feed ---
# How often (in seconds) to refresh the FireHOL blocklist (default: 300 = 5 min)
FEED_INTERVAL_SEC=300

# FireHOL blocklist URL (raw .netset from GitHub)
FIREHOL_URL=https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level1.netset

# --- Geolocation ---
# Maximum number of IPs per batch request to ip-api.com (max 100, default 50)
GEO_BATCH_SIZE=50
